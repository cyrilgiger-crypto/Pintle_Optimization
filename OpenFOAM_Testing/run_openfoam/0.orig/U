FoamFile
{
    version     2.0;
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    inlet_o
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.128; // [kg/s]
        rho             constant 1000;  // Liquid density [kg/m³]
        value           uniform (0 0 0);
    }

    inlet_f
    {
        type            flowRateInletVelocity;
        massFlowRate    constant 0.032; // [kg/s]
        rho             constant 1.2;   // Gas phase density [kg/m³]
        value           uniform (0 0 0);
    }

    "wall_.*"
    {
        type            noSlip;
    }

    outlet
    {
        type            pressureInletOutletVelocity;
        value           uniform (0 0 0);
    }

    "periodic_.*"
    {
        type            cyclicAMI;
    }
}


