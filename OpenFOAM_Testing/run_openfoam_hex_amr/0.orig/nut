FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;  // solver calculates nut from k and omega

boundaryField
{
    "pintleDomain_wall_.*"
    {
        type            nutkWallFunction;
        value           uniform 0;
    }

    "pintleDomain_inlet_.*"
    {
        type            calculated;
        value           uniform 0;
    }

    pintleDomain_outlet
    {
        type            calculated;
        value           uniform 0;
    }

    "pintleDomain_periodic_.*"
    {
        type            symmetry;
    }
}


