FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Set default phase fraction across the entire mesh (0 = gas/ambient)
defaultFieldValues
(
    volScalarFieldValue alpha.lox 0
);

// Overwrite alpha.lox = 1 inside the specified cylinder
regions
(
    cylinderToCell
    {
        p1      (-0.01 0 0);
        p2      (3e-3 0 0);
        radius  3.5e-3;

        fieldValues
        (
            volScalarFieldValue alpha.lox 1
        );
    }
);

