// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

castellatedMesh true;
snap            true;
addLayers       false;

mergeTolerance  1e-6;

geometry
{
    Slot_Pintle_Fluid_Domain.stl
    {
        type triSurfaceMesh;
        name pintleDomain;
    }
}

castellatedMeshControls
{
    maxLocalCells 1000000;
    maxGlobalCells 4000000;
    minRefinementCells 10;
    nCellsBetweenLevels 3;

    allowFreeStandingZoneFaces true;

    features
    (
        {
            file "Slot_Pintle_Fluid_Domain.eMesh";
            level 3;
        }
    );

    refinementSurfaces
    {
        pintleDomain
        {
            level (2 2);
            regions
            {
                wall_ch      { level (1 1); patchInfo { type wall; } }
                wall_of      { level (3 3); patchInfo { type wall; } }
                wall_i       { level (2 2); patchInfo { type wall; } }
                inlet_o      { level (3 3); patchInfo { type patch; } }
                inlet_f      { level (3 3); patchInfo { type patch; } }
                outlet       { level (1 1); patchInfo { type patch; } }
                periodic_0   { level (1 1); patchInfo { type patch; } }
                periodic_rev { level (1 1); patchInfo { type patch; } }
            }
            gapLevelIncrement 2;
        }
    }

    refinementRegions
    {
    }

    resolveFeatureAngle 30;

    locationInMesh (0.05 0.015 0.015);
}

snapControls
{
    nSolveIter 50;
    relaxIter 5;
    coordExponent 2;
    backOffFact 0.2;
    tolerance 1.0;
    nFeatureSnapIter 10;
    nSmoothPatch 3;
    nRelaxIter 5;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls {}

meshQualityControls
{
    maxNonOrtho 65;
    maxBoundarySkewness 20;
    maxInternalSkewness 4;
    maxConcave 80;
    minFlatness 0.5;
    minVol 1e-13;
    minTetQuality 1e-13;
    minArea -1;
    minTwist 0.05;
    minDeterminant 0.001;
    minFaceWeight 0.05;
    minVolRatio 0.01;
    minTriangleTwist -1;

    nSmoothScale 4;
    errorReduction 0.75;

    relaxed
    {
        maxNonOrtho 75;
    }
}